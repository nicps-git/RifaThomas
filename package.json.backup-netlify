{
  "name": "rifa-cha-thomas",
  "version": "2.0.0",
  "description": "Sistema de Rifa Online - Chá de Bebê Thomas com Firebase",
  "main": "index.html",
  "scripts": {
    "dev": "python -m http.server 8000",
    "deploy": "firebase deploy",
    "build": "echo 'Static site - no build process needed' && exit 0",
    "test": "echo 'No tests specified' && exit 0",
    "start": "echo 'Static site - use a web server to serve files' && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seu-usuario/rifa-cha-thomas"
  },
  "keywords": [
    "rifa",
    "cha-de-bebe",
    "firebase",
    "javascript",
    "real-time"
  ],
  "author": "Desenvolvedor Rifa Thomas",
  "license": "MIT",
  "dependencies": {
    "firebase": "^10.11.1"
  },
  "firebase": {
    "projectId": "rifa-cha-thomas",
    "hosting": {
      "public": ".",
      "ignore": [
        "node_modules/**",
        "*.md",
        ".git/**",
        ".gitignore"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  }
}
